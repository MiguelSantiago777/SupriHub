# Copie para .env e ajuste. Em produção, TODOS os segredos devem ser trocados.

# Perfil Spring: dev (usuários de demonstração, Swagger) ou prod
SPRING_PROFILES_ACTIVE=dev

# Banco de dados
DB_NAME=suprihub
DB_USER=suprihub
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# RabbitMQ (eventos de domínio e notificações)
RABBITMQ_USER=suprihub
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# JWT — mínimo 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# URL pública do frontend (usada nos links dos e-mails)
FRONTEND_URL=http://localhost:4200

# E-mail (em dev, MailHog captura tudo em http://localhost:8025)
MAIL_FROM=Contrata + NATA <nao-responda@institutonata.org.br>
# Produção: MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASSWORD, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true

# Primeiro administrador (criado se não existir nenhum ADMIN)
BOOTSTRAP_ADMIN_EMAIL=admin@suprihub.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-1

# Usuários de demonstração por perfil (<perfil>@suprihub.local / Senha@123). Use false em produção.
DEMO_USERS=true

# Portas expostas
BACKEND_PORT=8080
FRONTEND_PORT=4200
MAILHOG_UI_PORT=8025
