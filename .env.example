# Desenvolvimento: copie para .env e ajuste.
# Produção: NÃO use este arquivo — gere o .env.prod com segredos aleatórios:
#   ./scripts/gerar-env-producao.sh   (Linux/macOS/Git Bash)   ou   .\scripts\gerar-env-producao.ps1
# e suba com docker-compose.prod.yml (veja o README). O perfil prod recusa segredos de exemplo.

# Perfil Spring: dev (usuários de demonstração, Swagger) ou prod
SPRING_PROFILES_ACTIVE=dev

# Banco de dados
DB_NAME=suprihub
DB_USER=suprihub
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# RabbitMQ (eventos de domínio e notificações)
RABBITMQ_USER=suprihub
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# JWT — mínimo 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# URL pública do frontend (usada nos links dos e-mails)
FRONTEND_URL=http://localhost:4200

# E-mail (em dev, MailHog captura tudo em http://localhost:8025)
MAIL_FROM=Contrata + NATA <nao-responda@institutonata.org.br>
# Produção: MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASSWORD, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true

# Primeiro administrador (criado se não existir nenhum ADMIN)
BOOTSTRAP_ADMIN_EMAIL=admin@suprihub.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-1

# Usuários de demonstração por perfil (<perfil>@suprihub.local / Senha@123). Use false em produção.
DEMO_USERS=true

# Captcha (Cloudflare Turnstile) em login, cadastro e "esqueci a senha". Vazio = desligado.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Antivírus (clamd). Vazio = arquivos não verificados. Em produção o compose sobe o ClamAV.
CLAMAV_HOST=

# Portas expostas. Banco, RabbitMQ, MailHog e backend escutam só em 127.0.0.1;
# DEV_BIND=0.0.0.0 abre para a rede (o frontend já fica aberto).
DEV_BIND=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=4200
MAILHOG_UI_PORT=8025
